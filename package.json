{
  "name": "dsh-company",
  "version": "0.5.1",
  "private": false,
  "type": "module",
  "description": "Multi-agent agent team of employee AI subagents for DeepSeek Harness: employee management, CEO mission bidding, and n8n-style workflow orchestration (drag and drop employee nodes onto a canvas, wire them, run the graph in parallel). Seven built-in roles, each with its own persona, model and tools.",
  "license": "MIT",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "multi-agent",
    "agent-team",
    "ai-company",
    "multi agent",
    "agent team",
    "subagent",
    "sub-agent",
    "workflow",
    "orchestration",
    "n8n",
    "employee",
    "team",
    "ceo",
    "company",
    "agents",
    "workflow-automation",
    "drag-and-drop"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "screenshots.json",
    "README.md",
    "README.en.md",
    "LICENSE",
    "docs/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "author": "makooslee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makooslee/dsh-company.git"
  },
  "homepage": "https://github.com/makooslee/dsh-company#readme",
  "bugs": {
    "url": "https://github.com/makooslee/dsh-company/issues"
  }
}
